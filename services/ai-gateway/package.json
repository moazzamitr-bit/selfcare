  "dependencies": {
    "@fastify/helmet": "13.1.0",
    "@selfcare/contracts": "workspace:*",
    "@selfcare/observability": "workspace:*",
    "fastify": "5.10.0"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
